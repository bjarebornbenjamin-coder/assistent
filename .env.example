# --- Server (Vercel → Project Settings → Environment Variables). Aldrig VITE_-prefix på hemligheter. ---
OPENAI_API_KEY=sk-...          # OpenAI-nyckeln. Ligger bara på servern.
APP_PASSWORD=välj-ett-långt-lösenord   # Skyddar /api/chat och /api/models (skrivs in i appens Inställningar)
RATE_LIMIT_PER_MIN=20          # valfritt, standard 20 anrop/min

